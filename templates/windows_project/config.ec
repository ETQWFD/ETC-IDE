# ============================================================
#  ETC Lang 项目配置（config.ec）
#  编译时自动读取，生成 version.rc / manifest / AndroidManifest.xml
# ============================================================

[windows]
产品名称 = "ETC 程序"
文件说明 = "ETC Lang 编译产物"
公司名称 = "ET"
版权信息 = "Copyright (c) ET 2026"
文件版本 = "1.0.0.0"
产品版本 = "1.0.0.0"
程序图标 = ""            # .ico 路径（留空则用默认）
压缩打包 = true
压缩级别 = 9
去符号表 = true
UPX = true

[android]
软件名称 = "ETC 程序"
包名 = "com.etc.app"
版本号 = 1
版本名称 = "1.0"
应用图标 = ""            # 留空则用默认
最低支持安卓 = 21
最高支持安卓 = 35
资源压缩 = true
代码混淆 = true
